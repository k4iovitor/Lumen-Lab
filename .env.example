# ==========================================
# LumenLab - Variáveis de Ambiente (Exemplo)
# Copie este arquivo para .env e preencha seus valores
# ==========================================

# Configurações do Django
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=chave-secreta-para-desenvolvimento-lumenlab
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Google OAuth 2.0 (Autenticação do Estudante)
GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-google-client-secret

# Google Gemini API (Lumia: Grafo LangGraph + Embeddings RAG)
GEMINI_API_KEY=sua-chave-da-api-gemini-aqui
# GOOGLE_API_KEY=sua-chave-da-api-gemini-aqui

# Banco de Dados (PostgreSQL opcional; SQLite é usado por padrão)
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/lumenlab
